{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["node_modules/*"]
    },
    "typeRoots": [
      "src/types",
      "node_modules/@types"
    ]
  }
}
